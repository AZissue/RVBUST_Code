{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25 },
  "configurePresets": [
    {
      "name": "x64-Release",
      "displayName": "x64 Release (Ninja)",
      "description": "VS 打开文件夹模式使用；与命令行 build/ 目录互不冲突",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "D:/Qt/6.8.3/msvc2022_64",
        "CMAKE_CXX_COMPILER": "cl.exe"
      }
    },
    {
      "name": "x64-RelWithDebInfo",
      "displayName": "x64 RelWithDebInfo (Ninja)",
      "description": "带调试信息的 Release；链接 Release 版 Qt/PCL 库，部署的 Release DLL 可直接用",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_PREFIX_PATH": "D:/Qt/6.8.3/msvc2022_64",
        "CMAKE_CXX_COMPILER": "cl.exe"
      }
    }
  ],
  "buildPresets": [
    { "name": "x64-Release", "configurePreset": "x64-Release" },
    { "name": "x64-RelWithDebInfo", "configurePreset": "x64-RelWithDebInfo" }
  ],
  "testPresets": [
    {
      "name": "x64-Release",
      "configurePreset": "x64-Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
